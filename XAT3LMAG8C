<script>

    /* TYPING EFFECT */

    const text =
        "CYBERSECURITY • TECHNOLOGY • CODE • DIGITAL EXPLORATION";

    let index = 0;

    function typeText() {

        if (index < text.length) {

            document.getElementById("typing")
                .textContent += text.charAt(index);

            index++;

            setTimeout(typeText, 45);

        }

    }

    typeText();


    /* MATRIX EFFECT */

    const canvas =
        document.getElementById("matrix");

    const ctx =
        canvas.getContext("2d");

    function resizeCanvas() {

        canvas.width =
            window.innerWidth;

        canvas.height =
            window.innerHeight;

    }

    resizeCanvas();

    window.addEventListener(
        "resize",
        resizeCanvas
    );

    const characters =
        "01ABCDEFGHIJKLMNOPQRSTUVWXYZ#$%";

    const fontSize = 14;

    let columns =
        Math.floor(canvas.width / fontSize);

    let drops =
        Array(columns).fill(1);

    function matrix() {

        ctx.fillStyle =
            "rgba(0,0,0,0.06)";

        ctx.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

        ctx.fillStyle =
            "#00ff66";

        ctx.font =
            fontSize + "px monospace";

        for (
            let i = 0;
            i < drops.length;
            i++
        ) {

            const char =
                characters[
                    Math.floor(
                        Math.random() *
                        characters.length
                    )
                ];

            ctx.fillText(
                char,
                i * fontSize,
                drops[i] * fontSize
            );

            if (
                drops[i] * fontSize >
                canvas.height &&
                Math.random() > 0.975
            ) {
                drops[i] = 0;
            }

            drops[i]++;

        }

    }

    setInterval(matrix, 50);

</script>

